  @@index([status])
  @@index([campaignId])
  @@index([campaignName])
  @@index([sourceRecordType])
  @@index([sourceRecordId])
  @@index([overallScore])
  @@index([updatedAt])
}

/// Analytics learning library entry — insights from campaigns, analytics, experiments, and quality reviews.
model Learning {
  id                String   @id
  title             String   @default("")
  learningType      String   @default("Other")
  category          String   @default("")
  confidence        String   @default("Medium")
  impact            String   @default("Unknown")
  status            String   @default("Active")
  campaignId        String   @default("")
  campaignName      String   @default("")
  artistName        String   @default("")
  songTitle         String   @default("")
  productName       String   @default("")
  platform          String   @default("")
  sourceType        String   @default("")
  sourceId          String   @default("")
  analyticsRecordId String   @default("")
  experimentId      String   @default("")
  qualityReviewId   String   @default("")
  assetId           String   @default("")
  promptRunId       String   @default("")
  playbookId        String   @default("")
  insight           String   @default("")
  evidence          String   @default("")
  recommendation    String   @default("")
  repeatWhen        String   @default("")
  avoidWhen         String   @default("")
  tags              String   @default("[]")
  notes             String   @default("")
  createdAt         DateTime
  updatedAt         DateTime

  @@index([title])
  @@index([learningType])
  @@index([category])
  @@index([campaignId])
  @@index([campaignName])
  @@index([artistName])
  @@index([songTitle])
  @@index([platform])
  @@index([confidence])
  @@index([impact])
  @@index([status])
  @@index([updatedAt])
}

/// Singleton workspace defaults for CreatorOps (single row id: creatorops-workspace-default).
model WorkspaceSettings {
  id                    String   @id
  workspaceName         String   @default("")
  labelName             String   @default("")
  defaultYouTubeChannel String   @default("")
  defaultStoreName      String   @default("")
  defaultStoreType      String   @default("")
  defaultMerchStoreLink String   @default("")
  defaultWebsiteLink    String   @default("")
  defaultStreamingLink  String   @default("")
  defaultPlatforms      String   @default("")
  defaultCTA            String   @default("")
  defaultHashtagSet     String   @default("")
  defaultBrandTone      String   @default("")
  defaultVisualStyle    String   @default("")
  defaultAudience       String   @default("")
  defaultEmailSender    String   @default("")
  defaultBusinessArea   String   @default("")
  defaultPrimaryGoal    String   @default("")
  brandPrimaryColor     String   @default("")
  brandSecondaryColor   String   @default("")
  brandAccentColor      String   @default("")
  notes                 String   @default("")
  aiGenerationEnabled   Boolean  @default(false)
  aiDefaultProvider     String   @default("openai")
  aiDefaultModel        String   @default("")
  aiTemperature         Float    @default(0.7)
  aiMaxOutputTokens     Int      @default(2048)
  aiSystemStylePreference String @default("")
  aiSaveGenerationsAsPromptRuns Boolean @default(true)
  aiIncludeCampaignContextByDefault Boolean @default(true)
  aiIncludeLearningsByDefault Boolean @default(true)
  aiIncludeQualityNotesByDefault Boolean @default(true)
  createdAt             DateTime
  updatedAt             DateTime
}

/// External platform links — YouTube, Google Drive, Fourthwall, Suno, etc.
model ExternalLink {
  id                String   @id
  name              String
  platform          String
  linkType          String
  url               String
  status            String   @default("Active")
  campaignId        String   @default("")
  campaignName      String   @default("")
  artistName        String   @default("")
  songTitle         String   @default("")
  productName       String   @default("")
  sourceRecordType  String   @default("")
  sourceRecordId    String   @default("")
  assetId           String   @default("")
  analyticsRecordId String   @default("")
  notes             String   @default("")
  /// JSON string[]
  tags              String   @default("[]")
  createdAt         DateTime
  updatedAt         DateTime

  @@index([name])
  @@index([platform])
  @@index([linkType])
  @@index([campaignId])
  @@index([campaignName])
  @@index([sourceRecordType])
  @@index([sourceRecordId])
  @@index([assetId])
  @@index([analyticsRecordId])
  @@index([updatedAt])
}

/// Local YouTube OAuth connection — tokens encrypted; never exported in backups.
model YouTubeConnection {
  id                    String    @id
  accountEmail          String    @default("")
  channelId             String    @default("")
  channelTitle          String    @default("")
  channelHandle         String    @default("")
  channelUrl            String    @default("")
  thumbnailUrl          String    @default("")
  /// JSON string[]
  scopes                String    @default("[]")
  accessTokenEncrypted  String?
  refreshTokenEncrypted String?
  tokenType             String    @default("")
  expiryDate            DateTime?
  status                String    @default("Disconnected")
  lastSyncedAt          DateTime?
  notes                 String    @default("")
  createdAt             DateTime
  updatedAt             DateTime

  @@index([channelId])
  @@index([status])
  @@index([updatedAt])
}

/// Imported YouTube video metadata and sync state.
model YouTubeVideo {
  id                String    @id
  youtubeVideoId    String    @unique
  title             String
  description       String    @default("")
  channelId         String    @default("")
  channelTitle      String    @default("")
  publishedAt       DateTime?
  thumbnailUrl      String    @default("")
  videoUrl          String    @default("")
  duration          String    @default("")
  privacyStatus     String    @default("")
  campaignId        String    @default("")
  campaignName      String    @default("")
  artistName        String    @default("")
  songTitle         String    @default("")
  externalLinkId    String    @default("")
  analyticsRecordId String    @default("")
  /// Latest API payload including statistics
  rawJson           String    @default("{}")
  lastSyncedAt      DateTime?
  notes             String    @default("")
  createdAt         DateTime
  updatedAt         DateTime

  @@index([youtubeVideoId])
  @@index([channelId])
  @@index([campaignId])
  @@index([campaignName])
  @@index([publishedAt])
  @@index([updatedAt])
}

/// Local Google Drive OAuth connection — tokens encrypted; never exported in backups.
model DriveConnection {
  id                    String    @id
  accountEmail          String    @default("")
  displayName           String    @default("")
  /// JSON string[]
  scopes                String    @default("[]")
  accessTokenEncrypted  String?
  refreshTokenEncrypted String?
  tokenType             String    @default("")
  expiryDate            DateTime?
  status                String    @default("Disconnected")
  lastSyncedAt          DateTime?
  notes                 String    @default("")
  createdAt             DateTime
  updatedAt             DateTime

  @@index([status])
  @@index([updatedAt])
}

