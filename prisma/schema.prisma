model MockupPrompt {
  id                  String   @id
  projectName         String   @default("")
  mockupType          String   @default("")
  productType         String   @default("")
  niche               String   @default("")
  audience            String   @default("")
  designConcept       String   @default("")
  visualStyle         String   @default("")
  colors              String   @default("")
  setting             String   @default("")
  modelDescription    String   @default("")
  cameraAngle         String   @default("")
  lighting            String   @default("")
  mood                String   @default("")
  platformUse         String   @default("")
  aspectRatio         String   @default("")
  textToInclude       String   @default("")
  textToAvoid         String   @default("")
  brandNotes          String   @default("")
  completedPrompt     String   @default("")
  aiResponse          String   @default("")
  finalImagePrompt    String   @default("")
  finalNegativePrompt String   @default("")
  finalLayoutNotes    String   @default("")
  finalTextPlacement  String   @default("")
  finalUsageNotes     String   @default("")
  notes               String   @default("")
  createdAt           DateTime
  updatedAt           DateTime

  @@index([projectName])
  @@index([mockupType])
  @@index([productType])
  @@index([niche])
  @@index([platformUse])
  @@index([visualStyle])
  @@index([updatedAt])
}

// Email Campaign Generator — flat record per saved campaign
model EmailCampaign {
  id                   String   @id
  campaignName         String   @default("")
  campaignType         String   @default("")
  businessArea         String   @default("")
  audience             String   @default("")
  offerOrAnnouncement  String   @default("")
  productOrReleaseName String   @default("")
  keyBenefits          String   @default("")
  tone                 String   @default("")
  callToAction         String   @default("")
  link                 String   @default("")
  urgency              String   @default("")
  senderName           String   @default("")
  completedPrompt      String   @default("")
  aiResponse           String   @default("")
  finalSubjectLine     String   @default("")
  finalPreviewText     String   @default("")
  finalEmailBody       String   @default("")
  finalCTA             String   @default("")
  finalFollowUpEmail   String   @default("")
  finalResendSubject   String   @default("")
  finalResendBody      String   @default("")
  notes                String   @default("")
  createdAt            DateTime
  updatedAt            DateTime

  @@index([campaignName])
  @@index([campaignType])
  @@index([businessArea])
  @@index([productOrReleaseName])
  @@index([finalSubjectLine])
  @@index([senderName])
  @@index([updatedAt])
}

/// Campaign Builder — central launch hub linking records across CreatorOps modules.
model Campaign {
  id             String   @id
  campaignName   String   @default("")
  campaignType   String   @default("")
  status         String   @default("Idea")
  priority       String   @default("Medium")
  artistName     String   @default("")
  songTitle      String   @default("")
  productName    String   @default("")
  niche          String   @default("")
  primaryGoal    String   @default("")
  targetAudience String   @default("")
  startDate      String   @default("")
  launchDate     String   @default("")
  endDate        String   @default("")
  description    String   @default("")
  notes          String   @default("")
  lessonsLearned String   @default("")
  whatWorked     String   @default("")
  whatToImprove  String   @default("")
  /// JSON CampaignLinkedRecord[]
  linkedRecords  String   @default("[]")
  /// JSON CampaignTask[]
  tasks          String   @default("[]")
  /// JSON PublishingChecklist { version, items[] }
  publishingChecklist String @default("{}")
  createdAt      DateTime
  updatedAt      DateTime

  @@index([campaignName])
  @@index([campaignType])
  @@index([status])
  @@index([priority])
  @@index([artistName])
  @@index([songTitle])
  @@index([productName])
  @@index([niche])
  @@index([updatedAt])
}

/// Reusable presets / templates for fast module creation.
model Preset {
  id          String   @id
  name        String   @default("")
  description String   @default("")
  presetType  String   @default("Campaign")
  category    String   @default("")
  /// JSON string[] tags
  tags        String   @default("[]")
  /// JSON object of form field values
  values      String   @default("{}")
  notes       String   @default("")
  createdAt   DateTime
  updatedAt   DateTime

  @@index([name])
  @@index([presetType])
  @@index([category])
  @@index([updatedAt])
}

/// Creative variation / A-B test tracked in the Experiment Tracker.
model Experiment {
  id                    String   @id
  campaignId            String   @default("")
  campaignName          String   @default("")
  experimentName        String   @default("")
  experimentType        String   @default("")
  status                String   @default("Idea")
  platform              String   @default("")
  hypothesis            String   @default("")
  variantA              String   @default("")
  variantB              String   @default("")
  variantC              String   @default("")
  winner                String   @default("")
  resultSummary         String   @default("")
  metricFocus           String   @default("")
  startDate             String   @default("")
  endDate               String   @default("")
  notes                 String   @default("")
  whatWorked            String   @default("")
  whatDidNotWork        String   @default("")
  nextTestIdea          String   @default("")
  relatedAnalyticsNotes String   @default("")
  variantAMetric        String   @default("")
  variantBMetric        String   @default("")
  variantCMetric        String   @default("")
  analyticsRecordId   String   @default("")
  analyticsRecordName   String   @default("")
  confidenceNotes     String   @default("")
  learningSummary     String   @default("")
  createdAt             DateTime
  updatedAt             DateTime

  @@index([experimentName])
  @@index([analyticsRecordId])
  @@index([experimentType])
  @@index([status])
  @@index([campaignId])
  @@index([campaignName])
  @@index([platform])
  @@index([metricFocus])
  @@index([winner])
  @@index([updatedAt])
}

/// Creative asset metadata — files, URLs, references, and production assets.
model Asset {
  id                 String   @id
  assetName          String   @default("")
  assetType          String   @default("")
  status             String   @default("Draft")
  campaignId         String   @default("")
  campaignName       String   @default("")
  artistName         String   @default("")
  songTitle          String   @default("")
  productName        String   @default("")
  platform           String   @default("")
  filePath           String   @default("")
  fileUrl            String   @default("")
  externalUrl        String   @default("")
  sourceTool         String   @default("")
  sourcePromptRunId  String   @default("")
  sourcePromptName   String   @default("")
  sourceRecordType   String   @default("")
  sourceRecordId     String   @default("")
  experimentId       String   @default("")
  analyticsRecordId  String   @default("")
  versionLabel       String   @default("")
  tags               String   @default("[]")
  description        String   @default("")
  usageNotes         String   @default("")
  rightsNotes        String   @default("")
  notes              String   @default("")
  createdAt          DateTime
  updatedAt          DateTime

  @@index([assetName])
  @@index([assetType])
  @@index([campaignId])
  @@index([campaignName])
  @@index([artistName])
  @@index([songTitle])
  @@index([status])
  @@index([updatedAt])
}

/// Reusable SOP / launch playbooks for campaign systems.
model Playbook {
  id                          String   @id
  name                        String   @default("")
  description                 String   @default("")
  playbookType                String   @default("Other")
  category                    String   @default("")
  status                      String   @default("Active")
  targetCampaignType          String   @default("")
  recommendedPresetId         String   @default("")
  recommendedPresetName       String   @default("")
  recommendedWorkflowId       String   @default("")
  recommendedWorkflowName       String   @default("")
  defaultCampaignFields       String   @default("{}")
  taskTemplate                String   @default("[]")
  publishingChecklistTemplate String   @default("{}")
  assetChecklist              String   @default("[]")
  promptChecklist             String   @default("[]")
  experimentTemplate          String   @default("[]")
  automationNotes             String   @default("")
  exportPackTemplate          String   @default("")
  tags                        String   @default("[]")
  notes                       String   @default("")
  createdAt                   DateTime
  updatedAt                   DateTime

  @@index([name])
  @@index([playbookType])
  @@index([category])
  @@index([status])
  @@index([updatedAt])
}

/// Quality review / scorecard for creative outputs and campaign readiness.
model QualityReview {
  id                  String   @id
  reviewName          String   @default("")
  reviewType          String   @default("Other")
  status              String   @default("Draft")
  campaignId          String   @default("")
  campaignName        String   @default("")
  artistName          String   @default("")
  songTitle           String   @default("")
  productName         String   @default("")
  sourceRecordType    String   @default("")
  sourceRecordId      String   @default("")
  sourcePromptRunId   String   @default("")
  sourceExperimentId  String   @default("")
  platform            String   @default("")
  rubricVersion       String   @default("1")
  overallScore        Int      @default(0)
  scoreBreakdown      String   @default("{}")
  strengths           String   @default("")
  weaknesses          String   @default("")
  improvementIdeas    String   @default("")
  recommendedActions  String   @default("")
  readinessLabel      String   @default("")
  reviewerNotes       String   @default("")
  tags                String   @default("[]")
  createdAt           DateTime
