// CreatorOps Dashboard — Prisma schema
// TODO: Migrate dedicated modules (merch ideas, product listings, etc.) using the same pattern as Prompt.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

/// Reusable prompt templates for the Prompt Library and Prompt Runner.
model Prompt {
  id           String   @id
  name         String
  category     String
  description  String   @default("")
  promptText   String
  /// JSON string[] — variable names used in the template
  variables    String   @default("[]")
  outputFormat String   @default("")
  /// JSON string[]
  tags         String   @default("[]")
  rating       Int      @default(0)
  notes        String   @default("")
  createdAt    DateTime
  updatedAt    DateTime

  @@index([category])
  @@index([updatedAt])
}

/// Multi-step repeatable processes in Workflow Hub.
model Workflow {
  id                 String         @id
  name               String
  category           String
  description        String         @default("")
  status             String
  estimatedTimeSaved String         @default("")
  notes              String         @default("")
  createdAt          DateTime
  updatedAt          DateTime
  steps              WorkflowStep[]

  @@index([category])
  @@index([status])
  @@index([updatedAt])
}

/// Ordered step within a workflow; promptId references Prompt.id (soft link).
model WorkflowStep {
  id          String   @id
  workflowId  String
  sortOrder   Int
  title       String
  description String   @default("")
  promptId    String?
  workflow    Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId])
  @@index([promptId])
}

/// Saved execution of a prompt in Prompt Runner.
model PromptRun {
  id              String   @id
  promptId        String
  promptName      String
  category        String
  /// JSON Record<string, string> — variable values filled at run time
  inputValues     String   @default("{}")
  completedPrompt String   @default("")
  aiResponse      String   @default("")
  notes           String   @default("")
  createdAt       DateTime
  updatedAt       DateTime

  @@index([promptId])
  @@index([updatedAt])
}

/// Saved execution of a workflow in Workflow Runner.
model WorkflowRun {
  id           String            @id
  workflowId   String
  workflowName String
  category     String
  status       String
  notes        String            @default("")
  startedAt    DateTime
  updatedAt    DateTime
  completedAt  DateTime?
  stepRuns     WorkflowStepRun[]

  @@index([workflowId])
  @@index([status])
  @@index([updatedAt])
}

/// Step progress within a workflow run.
model WorkflowStepRun {
  id             String      @id
  workflowRunId  String
  sortOrder      Int
  workflowStepId String
  title          String
  description    String      @default("")
  promptId       String?
  promptName     String      @default("")
  status         String
  notes          String      @default("")
  completedAt    DateTime?
  workflowRun    WorkflowRun @relation(fields: [workflowRunId], references: [id], onDelete: Cascade)

  @@index([workflowRunId])
  @@index([workflowStepId])
}

/// Saved YouTube metadata package from the YouTube Packaging Tool.
model YouTubePackage {
  id                 String   @id
  trackTitle         String   @default("")
  artistName         String   @default("")
  channelName        String   @default("")
  genre              String   @default("")
  mood               String   @default("")
  targetListener     String   @default("")
  visualTheme        String   @default("")
  primaryGoal        String   @default("")
  merchTieIn         String   @default("")
  streamingLink      String   @default("")
  releaseDate        String   @default("")
  videoType          String   @default("")
  keywords           String   @default("")
  notes              String   @default("")
  completedPrompt    String   @default("")
  aiResponse         String   @default("")
  finalTitle         String   @default("")
  finalDescription   String   @default("")
  finalTags          String   @default("")
  finalHashtags      String   @default("")
  finalPinnedComment String   @default("")
  finalThumbnailText String   @default("")
  finalShortsCaption String   @default("")
  finalCommunityPost String   @default("")
  createdAt          DateTime
  updatedAt          DateTime

  @@index([trackTitle])
  @@index([artistName])
  @@index([updatedAt])
}

/// Saved YouTube thumbnail record from the YouTube Thumbnail Generator.
model YouTubeThumbnail {
  id                  String   @id
  trackTitle          String   @default("")
  artistName          String   @default("")
  videoTitle          String   @default("")
  contentFormat       String   @default("")
  videoType           String   @default("")
  genre               String   @default("")
  mood                String   @default("")
  targetAudience      String   @default("")
  visualTheme         String   @default("")
  hookAngle           String   @default("")
  mainSubject         String   @default("")
  textOverlay         String   @default("")
  colorDirection      String   @default("")
  brandingNotes       String   @default("")
  referenceStyle      String   @default("")
  ctaGoal             String   @default("")
  notes               String   @default("")
  completedPrompt     String   @default("")
  aiResponse          String   @default("")
  finalConcept        String   @default("")
  finalTextOverlay    String   @default("")
  finalComposition    String   @default("")
  finalColorDirection String   @default("")
  finalImagePrompt    String   @default("")
  finalAltVariation   String   @default("")
  finalShortsVersion  String   @default("")
  createdAt           DateTime
  updatedAt           DateTime

  @@index([trackTitle])
  @@index([artistName])
  @@index([videoTitle])
  @@index([updatedAt])
}

/// Saved release plan from the AI Music Release Planner.
model ReleasePlan {
  id                       String   @id
  artistName               String   @default("")
  songTitle                String   @default("")
  genre                    String   @default("")
  mood                     String   @default("")
  releaseDate              String   @default("")
  youtubeChannel           String   @default("")
  targetAudience           String   @default("")
  visualTheme              String   @default("")
  merchTieIn               String   @default("")
  streamingPlatforms       String   @default("")
  primaryGoal              String   @default("")
  notes                    String   @default("")
  completedPrompt          String   @default("")
  aiResponse               String   @default("")
  finalStrategySummary     String   @default("")
  finalTargetListener      String   @default("")
  finalPreReleasePlan      String   @default("")
  finalReleaseDayChecklist String   @default("")
  finalPostReleasePlan     String   @default("")
  finalYouTubePackage      String   @default("")
  finalShortFormIdeas      String   @default("")
  finalSocialCaptions      String   @default("")
  finalEmailAnnouncement   String   @default("")
  finalMerchTieIns         String   @default("")
  finalPriorityTasks       String   @default("")
  finalChecklist           String   @default("")
  createdAt                DateTime
  updatedAt                DateTime

  @@index([artistName])
  @@index([songTitle])
  @@index([releaseDate])
  @@index([updatedAt])
}

/// Artist / Label CRM profile.
model Artist {
  id               String           @id
  artistName       String           @default("")
  artistType       String           @default("")
  genre            String           @default("")
  subGenres        String           @default("")
  mood             String           @default("")
  brandDescription String           @default("")
  visualIdentity   String           @default("")
  targetAudience   String           @default("")
  contentStyle     String           @default("")
  youtubeChannel   String           @default("")
  spotifyLink      String           @default("")
  appleMusicLink   String           @default("")
  amazonMusicLink  String           @default("")
  websiteLink      String           @default("")
  merchStoreLink   String           @default("")
  socialLinks      String           @default("")
  notes            String           @default("")
  createdAt        DateTime
  updatedAt        DateTime
  releases         ArtistRelease[]
  products         ArtistProduct[]
  campaigns        ArtistCampaign[]

  @@index([artistName])
  @@index([artistType])
  @@index([genre])
  @@index([updatedAt])
}

/// Release tracked under an artist; soft links to other CreatorOps records.
model ArtistRelease {
  id                       String @id
  artistId                 String
  sortOrder                Int
  songTitle                String @default("")
  releaseDate              String @default("")
  genre                    String @default("")
  mood                     String @default("")
  status                   String @default("")
  youtubeUrl               String @default("")
  streamingLinks           String @default("")
  notes                    String @default("")
  thumbnailRecordId        String @default("")
  youtubePackagingRecordId String @default("")
  releasePlanRecordId      String @default("")
  analyticsRecordId        String @default("")
  artist                   Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@index([artistId])
  @@index([songTitle])
  @@index([thumbnailRecordId])
  @@index([youtubePackagingRecordId])
  @@index([releasePlanRecordId])
  @@index([analyticsRecordId])
}

/// Merch / product tracked under an artist.
model ArtistProduct {
  id          String @id
  artistId    String
  sortOrder   Int
  productName String @default("")
  productType String @default("")
  status      String @default("")
  storeLink   String @default("")
  notes       String @default("")
  artist      Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@index([artistId])
}

/// Campaign tracked under an artist.
model ArtistCampaign {
  id           String @id
  artistId     String
  sortOrder    Int
  campaignName String @default("")
  campaignType String @default("")
  status       String @default("")
  startDate    String @default("")
  endDate      String @default("")
  notes        String @default("")
  artist       Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@index([artistId])
}

/// Saved merch concept from the Merch Idea Generator.
model MerchIdea {
  id                         String   @id
  niche                      String   @default("")
  audience                   String   @default("")
  productType                String   @default("")
  tone                       String   @default("")
  noun                       String   @default("")
  verb                       String   @default("")
  designStyle                String   @default("")
  storeType                  String   @default("")
  primaryGoal                String   @default("")
  completedPrompt            String   @default("")
  aiResponse                 String   @default("")
  selectedConceptName        String   @default("")
  selectedSlogan             String   @default("")
  selectedDesignDirection    String   @default("")
  selectedProductTitle       String   @default("")
  selectedProductDescription String   @default("")
  selectedTags               String   @default("")
  selectedMockupIdea         String   @default("")
  selectedSocialCaption      String   @default("")
  notes                      String   @default("")
  createdAt                  DateTime
  updatedAt                  DateTime

  @@index([niche])
  @@index([productType])
  @@index([storeType])
  @@index([selectedConceptName])
  @@index([updatedAt])
}

/// Saved product listing from the Product Listing Generator.
model ProductListing {
  id                     String   @id
  productType            String   @default("")
  niche                  String   @default("")
  audience               String   @default("")
  designConcept          String   @default("")
  tone                   String   @default("")
  primaryKeyword         String   @default("")
  secondaryKeywords      String   @default("")
  storeName              String   @default("")
  productBenefits        String   @default("")
  pricingNotes           String   @default("")
  completedPrompt        String   @default("")
  aiResponse             String   @default("")
  finalTitle             String   @default("")
  finalShortDescription  String   @default("")
  finalLongDescription   String   @default("")
  finalBulletPoints      String   @default("")
  finalTags              String   @default("")
  finalCollection        String   @default("")
  finalCTA               String   @default("")
  finalSocialCaption     String   @default("")
  finalEmailSubject      String   @default("")
  notes                  String   @default("")
  createdAt              DateTime
  updatedAt              DateTime

  @@index([productType])
  @@index([niche])
  @@index([storeName])
  @@index([primaryKeyword])
  @@index([finalTitle])
  @@index([finalCollection])
  @@index([updatedAt])
}

/// Saved social repurposing campaign from the Social Repurposing Engine.
model SocialRepurposing {
  id                       String   @id
  campaignName             String   @default("")
  sourceContent            String   @default("")
  businessArea             String   @default("")
  goal                     String   @default("")
  audience                 String   @default("")
  tone                     String   @default("")
  platforms                String   @default("")
  callToAction             String   @default("")
  productOrReleaseLink     String   @default("")
  contentType              String   @default("")
  completedPrompt          String   @default("")
  aiResponse               String   @default("")
  finalCoreMessage         String   @default("")
  finalTikTokCaption       String   @default("")
  finalInstagramCaption    String   @default("")
  finalXPost               String   @default("")
  finalYouTubeShortsIdea    String   @default("")
  finalYouTubeCommunityPost String  @default("")
  finalEmailSnippet        String   @default("")
  finalHashtags            String   @default("")
  finalCTA                 String   @default("")
  notes                    String   @default("")
  createdAt                DateTime
  updatedAt                DateTime

  @@index([campaignName])
  @@index([contentType])
  @@index([businessArea])
  @@index([goal])
  @@index([platforms])
  @@index([finalCoreMessage])
  @@index([updatedAt])
}

/// Saved performance tracking record from the Analytics Tracker.
model AnalyticsRecord {
  id                  String   @id
  itemName            String   @default("")
  itemType            String   @default("")
  relatedArtist       String   @default("")
  relatedSong         String   @default("")
  relatedCampaign     String   @default("")
  platform            String   @default("")
  publishDate         String   @default("")
  url                 String   @default("")
  niche               String   @default("")
  genre               String   @default("")
  mood                String   @default("")
  titleUsed           String   @default("")
  thumbnailText       String   @default("")
  descriptionNotes    String   @default("")
  tagsUsed            String   @default("")
  callToAction        String   @default("")
  views               Float    @default(0)
  impressions         Float    @default(0)
  clicks              Float    @default(0)
  clickThroughRate    Float    @default(0)
  likes               Float    @default(0)
  comments            Float    @default(0)
  shares              Float    @default(0)
  saves               Float    @default(0)
  subscribersGained   Float    @default(0)
  watchTimeHours      Float    @default(0)
  averageViewDuration Float    @default(0)
  retentionNotes      String   @default("")
  revenue             Float    @default(0)
  sales               Float    @default(0)
  conversionRate      Float    @default(0)
  whatWorked          String   @default("")
  whatDidNotWork      String   @default("")
  improvementIdeas    String   @default("")
  nextActions         String   @default("")
  rating              Float    @default(0)
  notes               String   @default("")
  createdAt           DateTime
  updatedAt           DateTime

  @@index([itemName])
  @@index([itemType])
  @@index([platform])
  @@index([relatedArtist])
  @@index([relatedSong])
  @@index([relatedCampaign])
  @@index([views])
  @@index([updatedAt])
}

/// Saved mockup prompt project from the Mockup Prompt Generator.
model MockupPrompt {
  id                  String   @id
  projectName         String   @default("")
  mockupType          String   @default("")
  productType         String   @default("")
  niche               String   @default("")
  audience            String   @default("")
  designConcept       String   @default("")
  visualStyle         String   @default("")
  colors              String   @default("")
  setting             String   @default("")
  modelDescription    String   @default("")
  cameraAngle         String   @default("")
  lighting            String   @default("")
  mood                String   @default("")
  platformUse         String   @default("")
  aspectRatio         String   @default("")
  textToInclude       String   @default("")
  textToAvoid         String   @default("")
  brandNotes          String   @default("")
  completedPrompt     String   @default("")
  aiResponse          String   @default("")
  finalImagePrompt    String   @default("")
  finalNegativePrompt String   @default("")
  finalLayoutNotes    String   @default("")
  finalTextPlacement  String   @default("")
  finalUsageNotes     String   @default("")
  notes               String   @default("")
  createdAt           DateTime
  updatedAt           DateTime

  @@index([projectName])
  @@index([mockupType])
  @@index([productType])
  @@index([niche])
  @@index([platformUse])
  @@index([visualStyle])
  @@index([updatedAt])
}

// Email Campaign Generator — flat record per saved campaign
model EmailCampaign {
  id                   String   @id
  campaignName         String   @default("")
  campaignType         String   @default("")
  businessArea         String   @default("")
  audience             String   @default("")
  offerOrAnnouncement  String   @default("")
  productOrReleaseName String   @default("")
  keyBenefits          String   @default("")
  tone                 String   @default("")
  callToAction         String   @default("")
  link                 String   @default("")
  urgency              String   @default("")
  senderName           String   @default("")
  completedPrompt      String   @default("")
  aiResponse           String   @default("")
  finalSubjectLine     String   @default("")
  finalPreviewText     String   @default("")
  finalEmailBody       String   @default("")
  finalCTA             String   @default("")
  finalFollowUpEmail   String   @default("")
  finalResendSubject   String   @default("")
  finalResendBody      String   @default("")
  notes                String   @default("")
  createdAt            DateTime
  updatedAt            DateTime

  @@index([campaignName])
  @@index([campaignType])
  @@index([businessArea])
  @@index([productOrReleaseName])
  @@index([finalSubjectLine])
  @@index([senderName])
  @@index([updatedAt])
}
