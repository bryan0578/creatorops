  updatedAt         DateTime  @updatedAt

  @@index([platform])
  @@index([source])
  @@index([productName])
  @@index([productListingId])
  @@index([campaignId])
  @@index([collectionId])
  @@index([artistName])
  @@index([saleDate])
  @@index([updatedAt])
