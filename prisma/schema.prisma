// CreatorOps Dashboard — Prisma schema
// TODO: Migrate dedicated modules (merch ideas, product listings, etc.) using the same pattern as Prompt.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

/// Reusable prompt templates for the Prompt Library and Prompt Runner.
model Prompt {
  id           String   @id
  name         String
  category     String
  description  String   @default("")
  promptText   String
  /// JSON string[] — variable names used in the template
  variables    String   @default("[]")
  outputFormat String   @default("")
  /// JSON string[]
  tags         String   @default("[]")
  rating       Int      @default(0)
  notes        String   @default("")
  createdAt    DateTime
  updatedAt    DateTime

  @@index([category])
  @@index([updatedAt])
}

/// Multi-step repeatable processes in Workflow Hub.
model Workflow {
  id                 String         @id
  name               String
  category           String
  description        String         @default("")
  status             String
  estimatedTimeSaved String         @default("")
  notes              String         @default("")
  createdAt          DateTime
  updatedAt          DateTime
  steps              WorkflowStep[]

  @@index([category])
  @@index([status])
  @@index([updatedAt])
}

/// Ordered step within a workflow; promptId references Prompt.id (soft link).
model WorkflowStep {
  id          String   @id
  workflowId  String
  sortOrder   Int
  title       String
  description String   @default("")
  promptId    String?
  workflow    Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId])
  @@index([promptId])
}

/// Saved execution of a prompt in Prompt Runner.
model PromptRun {
  id              String   @id
  promptId        String
  promptName      String
  category        String
  /// JSON Record<string, string> — variable values filled at run time
  inputValues     String   @default("{}")
  completedPrompt String   @default("")
  aiResponse      String   @default("")
  notes           String   @default("")
  createdAt       DateTime
  updatedAt       DateTime

  @@index([promptId])
  @@index([updatedAt])
}

/// Saved execution of a workflow in Workflow Runner.
model WorkflowRun {
  id           String            @id
  workflowId   String
  workflowName String
  category     String
  status       String
  notes        String            @default("")
  startedAt    DateTime
  updatedAt    DateTime
  completedAt  DateTime?
  stepRuns     WorkflowStepRun[]

  @@index([workflowId])
  @@index([status])
  @@index([updatedAt])
}

/// Step progress within a workflow run.
model WorkflowStepRun {
  id             String      @id
  workflowRunId  String
  sortOrder      Int
  workflowStepId String
  title          String
  description    String      @default("")
  promptId       String?
  promptName     String      @default("")
  status         String
  notes          String      @default("")
  completedAt    DateTime?
  workflowRun    WorkflowRun @relation(fields: [workflowRunId], references: [id], onDelete: Cascade)

  @@index([workflowRunId])
  @@index([workflowStepId])
}

/// Saved YouTube metadata package from the YouTube Packaging Tool.
model YouTubePackage {
  id                 String   @id
  trackTitle         String   @default("")
  artistName         String   @default("")
  channelName        String   @default("")
  genre              String   @default("")
  mood               String   @default("")
  targetListener     String   @default("")
  visualTheme        String   @default("")
  primaryGoal        String   @default("")
  merchTieIn         String   @default("")
  streamingLink      String   @default("")
  releaseDate        String   @default("")
  videoType          String   @default("")
  keywords           String   @default("")
  notes              String   @default("")
  completedPrompt    String   @default("")
  aiResponse         String   @default("")
  finalTitle         String   @default("")
  finalDescription   String   @default("")
  finalTags          String   @default("")
  finalHashtags      String   @default("")
  finalPinnedComment String   @default("")
  finalThumbnailText String   @default("")
  finalShortsCaption String   @default("")
  finalCommunityPost String   @default("")
  createdAt          DateTime
  updatedAt          DateTime

  @@index([trackTitle])
  @@index([artistName])
  @@index([updatedAt])
}

/// Saved YouTube thumbnail record from the YouTube Thumbnail Generator.
model YouTubeThumbnail {
  id                  String   @id
  trackTitle          String   @default("")
  artistName          String   @default("")
  videoTitle          String   @default("")
  contentFormat       String   @default("")
  videoType           String   @default("")
  genre               String   @default("")
  mood                String   @default("")
  targetAudience      String   @default("")
  visualTheme         String   @default("")
  hookAngle           String   @default("")
  mainSubject         String   @default("")
  textOverlay         String   @default("")
  colorDirection      String   @default("")
  brandingNotes       String   @default("")
  referenceStyle      String   @default("")
  ctaGoal             String   @default("")
  notes               String   @default("")
  completedPrompt     String   @default("")
  aiResponse          String   @default("")
  finalConcept        String   @default("")
  finalTextOverlay    String   @default("")
  finalComposition    String   @default("")
  finalColorDirection String   @default("")
  finalImagePrompt    String   @default("")
  finalAltVariation   String   @default("")
  finalShortsVersion  String   @default("")
  createdAt           DateTime
  updatedAt           DateTime

  @@index([trackTitle])
  @@index([artistName])
  @@index([videoTitle])
  @@index([updatedAt])
}
