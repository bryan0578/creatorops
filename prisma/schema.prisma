/// Product research opportunities before merch/listing creation.
model ProductResearchItem {
  id              String    @id @default(cuid())
  title           String
  productType     String    @default("")
  category        String    @default("")
  niche           String    @default("")
  audience        String    @default("")
  platform        String    @default("")
  inspirationUrl  String    @default("")
  competitorName  String    @default("")
  priceRange      String    @default("")
  demandSignal    String    @default("")
  difficulty      String    @default("")
  opportunityScore Float?
  status          String    @default("Idea")
  campaignId      String    @default("")
  campaignName    String    @default("")
  artistName      String    @default("")
  productName     String    @default("")
  notes           String    @default("")
  tags            String    @default("[]")
  rawJson         String    @default("{}")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status])
  @@index([productType])
  @@index([category])
  @@index([campaignId])
  @@index([artistName])
  @@index([updatedAt])
}

/// Product drops / collections grouping listings, merch, and assets.
model ProductCollection {
  id               String    @id @default(cuid())
